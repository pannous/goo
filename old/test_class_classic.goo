class tee{
// same as test_class_methods.goo but with flipped order of types (x int) => (int x)
		int x
		int y
		tee(int x, int y) {
				this.x = x
				this.y = y
		}
		sum() int { return x + y }
		display() { print("x: " + x + ", y: " + y) }
}
t := tee(3, 4)
t.display()
print("Sum: " + t.sum())
return
