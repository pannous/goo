check [1, 2, 3].first() == 1
check [1, 2, 3].last() == 3
check [1, 2, 3].size() == 3
check [1, 2, 3].length() == 3
check [].isEmpty() == true
check [1].isEmpty() == false

check [1, 2, 3].reverse() == [3, 2, 1]
check [1, 2, 3].contains(2) == true
check [1, 2, 3].contains(5) == false

check [1, 2, 3].indexOf(2) == 1
check [1, 2, 3].indexOf(5) == -1

check [1, 2, 3][1:] == [2, 3]
check [1, 2, 3][:2] == [1, 2]
check [1, 2, 3][1:2] == [2]       // slice(start, end)

check [1, 2, 3].join("-") == "1-2-3"  // if all elements stringifiable
check [1, 2, 3].map(x => x*2) == [2, 4, 6]
check [1, 2, 3].filter(x => x%2==1) == [1, 3]
check [1, 2, 3].reduce((a,b)=>a+b, 0) == 6

check [3,1,2].sort() == [1,2,3]
check [3,1,2].sortDesc() == [3,2,1]

check [1,2,3].append(4) == [1,2,3,4]
check [1,2,3].prepend(0) == [0,1,2,3]
check [1,2,3].insert(1,1) == [1,1,2,3]  // 0: before index 0 == prepend
#check [1,2,3].insert(at = 0,1) == [1,1,2,3]  // 0: before index 0 == prepend
#check [1,2,3].insert(0, at = 1) == [1,0,2,3]  // 0: before index 0 == prepend

check [1,2,3].pop() == 3 // and removes it
check [1,2,3].shift() == 1 // and removes it

check [1,2,3].slice(1,2) == [2]
check [1,2,3].copy() == [1,2,3]