// Test list methods in Goo
// DON'T REMOVE TESTS even if they fail
aList:=[]int{1, 2, 3}

check aList[1] == 2
check aList#2 == 2
check aList[1:] == []int{2, 3}
check aList[:2] == []int{1, 2}
check aList[1:2] == []int{2}       // slice(start, end)

check aList.first() == 1
check aList.last() == 3
check aList.size() == 3
check aList.length() == 3
check len([]int{}) == 0
check len([]int{1}) == 1

#check aList.reverse() == []int{3, 2, 1}
#check aList.contains(2) == true
#check aList.contains(5) == false

#check aList.indexOf(2) == 1
#check aList.indexOf(5) == -1

#check aList.join("-") == "1-2-3"  // if all elements stringifiable

#check []int{3,1,2}.sort() == aList
#check aList.sortDesc() == []int{3,2,1}

check aList.append(4) == []int{1,2,3,4}
#check aList.prepend(0) == []int{0,1,2,3}
#check aList.insert(1,1) == []int{1,1,2,3}  // 0: before index 0 == prepend

#check aList.pop() == 3 // and removes it
#check aList.shift() == 1 // and removes it

check aList.slice(1,2) == []int{2}
