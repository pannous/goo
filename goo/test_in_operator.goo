import "strings"

// Test in operator with strings
text := "hello world"
result1 := "hello" in text
result2 := "xyz" in text

printf("'hello' in 'hello world': %t\n", result1)
printf("'xyz' in 'hello world': %t\n", result2)

// Test with string literals
result3 := "a" in "abc"
result4 := "d" in "abc"

printf("'a' in 'abc': %t\n", result3)
printf("'d' in 'abc': %t\n", result4)