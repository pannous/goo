func substring(s string, start, end int) string {
    i, j := 0, 0
    for idx := range s {
        if i == start {
            j = idx
        }
        if i == end {
            return s[j:idx]
        }
        i++
    }
    if i == end {
        return s[j:]
    }
    return ""
}

func reverseString(s string) string {
    runes := []rune(s)
    for i, j := 0, len(runes)-1; i < j; i, j = i+1, j-1 {
        runes[i], runes[j] = runes[j], runes[i]
    }
    return string(runes)
}

