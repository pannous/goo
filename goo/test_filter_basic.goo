// Basic filter test
import "fmt" // TODO imports where NOT necessary at one point!!
import "slices"

numbers := [1, 2, 3, 4, 5, 6]

// This should transform to: slices.Filter(numbers, func(x any) bool { return x % 2 == 0 })
evens := numbers.filter(x => x % 2 == 0)
	put("Filter result:", evens)
check evens == [2 4 6]
