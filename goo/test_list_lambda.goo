import fmt
import slices

# depends on test_list_typed.goo and map function test_list_map.goo
xs := []int{1, 2, 3}
ys := xs.apply(x=>x*2) // should return []int{2, 4, 6}

check ys == []int{2, 4, 6}

nums := []int{1, 2, 3, 4, 5}
check nums.filter(x => x%2==1) == []int{1, 3, 5}
#check nums.reduce((a,b)=>a+b, 0) == 15


class User{
		name string
		age  int
}


users := []User{
	{name: "Alice", age: 20},
	{name: "Bob", age: 17},
	{name: "Charlie", age: 22},
	{name: "Diana", age: 15},
}
u := users.filter(u => u.age > 18) .apply(u => u.name) .sort() .first()
#u := users.apply(u => u.name) .sort() .first()
#u := users.sort() .first()
check u == "Alice"
put("All lambda tests passed")

