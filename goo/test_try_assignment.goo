import "strconv"

func testAssignment() error {
	try val := "42" as int
	println("Converted value:", val)
	
	try val2 := "invalid" as int
	println("This should not print:", val2)
	
	return nil
}

func main() {
	err := testAssignment()
	if err { return println("Error occurred:", err) }
	println("This should not print")
}