// Comprehensive list/array syntax tests

// Empty list literals
empty := []
println("Empty list length:", len(empty))
check len(empty) == 0

// Regular list syntax
numbers := [1, 2, 3]
mixed := ["hello", 2, true]
println("Numbers:", numbers)
println("Mixed:", mixed)

// Whitespace-separated lists (if supported)
whitespace_list := [1 2 3]
println("Whitespace list:", whitespace_list)

// List assignments
list1 := [1, 2]
list2 := [3, 4]
combined := append(list1, list2...)
println("Combined:", combined)

// List indexing
check numbers[0] == 1
check numbers#0 == 1  // Hash indexing

println("All list tests completed!")