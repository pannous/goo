import slices

type User struct {
	Name string
	Age  int
}

func main() {
	users := []User{
		{Name: "Alice", Age: 20},
		{Name: "Bob", Age: 17},
	}
	
	// Test slices.Filter directly with User type
	filtered := slices.Filter(users, func(u User) bool {
		return u.Age > 18
	})
	print(users.filter(u=>u.Age>18))
	
	println("Filtered users:", len(filtered))
}