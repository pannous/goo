// Comprehensive units test without problematic expressions
import "units"

func main() {
	println("=== Comprehensive Units Test (Fixed) ===")
	
	// Test Available function
	categories := units.Available()
	println("Found", len(categories), "unit categories")
	
	// Test basic unit conversions
	// Length conversions
	check 1000mm == 1m
	check 100cm == 1m  
	check 1km == 1000m
	
	// Time conversions  
	check 1000ms == 1s
	check 60s == 1min
	check 60min == 1h
	
	// Mass conversions
	check 1000g == 1kg
	check 1000kg == 1t
	
	// Energy conversions 
	j_val := 1000J
	kj_val := 1kJ
	check j_val == kj_val
	
	// Power units
	w_val := 1000W  
	kw_val := 1kW
	check w_val == kw_val
	
	// Pressure units
	pa_val := 100000Pa
	bar_val := 1bar
	check pa_val == bar_val
	
	// Area units
	m2_val := 10000m²
	ha_val := 1ha  
	check m2_val == ha_val
	
	// Volume units
	ml_val := 1000mL
	l_val := 1L
	check ml_val == l_val
	
	// Test velocity units (without complex expressions)
	mps_val := 1m/s
	println("1 m/s:", mps_val.ToString())
	
	// Test angle units
	deg_val := 180°
	println("180 degrees:", deg_val.ToString())
	
	// Test g-force
	gf_val := 1gf
	println("1 g-force:", gf_val.ToString())
	
	println("All comprehensive unit tests passed!")
}