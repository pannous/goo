package main

import "math"
import "github.com/veandco/go-sdl2/sdl"

try sdl.Init(sdl.INIT_EVERYTHING)
defer sdl.Quit()

try window := sdl.CreateWindow("test", sdl.WINDOWPOS_UNDEFINED, sdl.WINDOWPOS_UNDEFINED, 800, 600, sdl.WINDOW_SHOWN)
defer window.Destroy()

try renderer := sdl.CreateRenderer(window, -1, sdl.RENDERER_ACCELERATED | sdl.RENDERER_PRESENTVSYNC)
defer renderer.Destroy()

rect := sdl.Rect{X: 0, Y: 0, W: 200, H: 200}
dx := int32(5) // speed
colour := sdl.Color{R: 255, G: 0, B: 255, A: 255} // purple
renderer.SetDrawColor(colour.R, colour.G, colour.B, colour.A)

var mouseX, mouseY int32

running := true
step := 0
while running {
	step++
	mouseX, mouseY, _ = sdl.GetMouseState()

	rect.X += dx
	if rect.X > 800 {
		rect.X = -rect.W
	}

	// gravitate toward mouseY
	dy := float32(mouseY - rect.Y)
	rect.Y += int32(dy * 0.1) // adjust 0.1 for responsiveness

	for event := sdl.PollEvent(); event != nil; event = sdl.PollEvent() {
		switch event.(type) {
		case *sdl.QuitEvent: // NOTE: Please use `*sdl.QuitEvent` for `v0.4.x` (current version).
			running = false
		}
	}
	// redraw
	renderer.SetDrawColor(0, 0, 0, 255) // clear screen to black
	renderer.Clear()

	t := float32(step % 256) / 255.0
	colour := sdl.Color{
		R: uint8(127 + 127*float32(math.Sin(float64(t*2*3.14159265)))),
		G: uint8(127 + 127*float32(math.Sin(float64((t+0.33)*2*3.14159265)))),
		B: uint8(127 + 127*float32(math.Sin(float64((t+0.66)*2*3.14159265)))),
		A: 255,
	}
	renderer.SetDrawColor(colour.R, colour.G, colour.B, colour.A)
	renderer.FillRect(&rect)

	renderer.Present()

	sdl.Delay(33)
}
