import "fmt"

s := "你好世界"
fmt.Printf("runeAt(0) = %s\n", s.runeAt(0))
fmt.Printf("runeAt(1) = %s\n", s.runeAt(1))
fmt.Printf("runeAt(2) = %s\n", s.runeAt(2))
fmt.Printf("runeAt(3) = %s\n", s.runeAt(3))

// Test with mixed content
mixed := "Hi你好"
fmt.Printf("mixed.runeAt(0) = %s\n", mixed.runeAt(0))
fmt.Printf("mixed.runeAt(1) = %s\n", mixed.runeAt(1))
fmt.Printf("mixed.runeAt(2) = %s\n", mixed.runeAt(2))
fmt.Printf("mixed.runeAt(3) = %s\n", mixed.runeAt(3))