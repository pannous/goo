import "strconv"

// Test all the working semantic conversions
printf("Testing working as conversions:\n")

// String conversions (int -> string works)
result1 := 1 as string
printf("1 as string: '%s' (should be '1')\n", result1)

// Rune conversions (both directions work)  
result2 := 1 as rune
result3 := '1' as int
printf("1 as rune: '%c' (should be '1')\n", result2)
printf("'1' as int: %d (should be 1)\n", result3)

// Numeric conversions (int -> float works)
result4 := 3 as float64
printf("3 as float64: %.1f (should be 3.0)\n", result4)

// Test check statements
check 1 as string == "1"
check 1 as rune == '1'  
check '1' as int == 1
check 3 as float64 == 3.0

printf("All working conversions passed!\n")