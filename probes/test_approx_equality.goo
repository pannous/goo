// Test ≈ (approximate equality) operator  
import "math"

// Test basic approximate equality
a := 3.14159
b := 3.14160
println("3.14159 ≈ 3.14160:", a ≈ b)

// Test τ ≈ 2π
println("τ ≈ 2π:", τ ≈ 2*π)

// Test with floating point precision issues  
c := 0.1 + 0.2
d := 0.3
println("0.1 + 0.2 =", c)
println("0.3 =", d) 
println("(0.1 + 0.2) == 0.3:", c == d)
println("(0.1 + 0.2) ≈ 0.3:", c ≈ d)

// Test with larger differences
e := 1.0
f := 1.1
println("1.0 ≈ 1.1:", e ≈ f)

// Test π approximations
pi_approx := 22.0 / 7.0  // Common π approximation
println("π ≈ 22/7:", π ≈ pi_approx)
println("π =", π)
println("22/7 =", pi_approx)

// Test exact equality still works
g := 5.0
h := 5.0
println("5.0 ≈ 5.0:", g ≈ h)