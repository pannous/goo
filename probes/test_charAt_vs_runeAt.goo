import "fmt"

// ASCII string
s1 := "hello"
fmt.Printf("ASCII string '%s':\n", s1)
fmt.Printf("  charAt(1) = %s\n", s1.charAt(1))
fmt.Printf("  runeAt(1) = %s\n", s1.runeAt(1))

// Unicode string - runeAt should eventually handle this correctly
s2 := "你好"
fmt.Printf("Unicode string '%s':\n", s2)
fmt.Printf("  charAt(0) = %s\n", s2.charAt(0))
fmt.Printf("  runeAt(0) = %s\n", s2.runeAt(0))