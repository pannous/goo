// Test list assignment syntax

func main() {
	// This should work - comma-separated
	nums1 := [1, 2, 3]
	printf("nums1: %v\n", nums1)
	
	// This should work - whitespace-separated
	nums2 := [1 2 3]
	printf("nums2: %v\n", nums2)
	
	// This should work - character literals
	chars := ['a', 'b', 'c']
	printf("chars: %v\n", chars)
}