// Simple precedence test without imports

// Test basic precedence - should parse as: not (4 in [1, 2, 3])
result1 := not 4 in [1, 2, 3]

// Test with variables
x := 4
y := [1, 2, 3]
result2 := not x in y

// Test string precedence - should parse as: not ("hello" in "world")
text := "world"
result3 := not "hello" in text