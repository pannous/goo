#!/usr/bin/env goo
// Test various hash scenarios

// These should be comments (space/tab before #)
x := 5 # comment with space
y := 10	# comment with tab

// These should be index operations (no space before #)
arr := [100, 200, 300]
first := arr#0   // Should work: 100
second := arr#1  // Should work: 200

printf("First: %d\n", first)
printf("Second: %d\n", second)
printf("Hash detection works!")