import "strconv"

// Test comprehensive string conversions to ensure no regressions

// Base type conversions should still work
printf("=== Base Type Conversions ===\n")
check 1 as string == "1"          // int to string via strconv.Itoa
check 1 as rune == '1'            // int to rune 
check '1' as int == 1             // rune to int
check 3 as float64 == 3.0         // int to float

printf("Base type conversions work!\n")

// Custom type with String() method
type Book struct {
    title string
    pages int
}

func (b Book) String() string {
    return b.title + " (" + strconv.Itoa(b.pages) + " pages)"
}

printf("\n=== Custom Type String() Method ===\n")
book := Book{title: "Go Programming", pages: 300}
result := book as string
printf("Book as string: %s\n", result)
check result == "Go Programming (300 pages)"

// Pointer to custom type
bookPtr := &book
result2 := bookPtr as string
printf("Book pointer as string: %s\n", result2)

printf("\n=== All conversions working! ===\n")