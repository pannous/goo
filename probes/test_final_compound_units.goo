import "units"

print("=== Final Compound Units Solution ===")

// Your original examples with working ASCII alternatives:

s := units.S
print("s =", s.Value())

// s² equivalent
s_squared := s.Multiply(s.Value())
print("s² =", s_squared.Value())

// Your acceleration example  
mps2_val := 9.80665mps2
gf_val := 1gf
check mps2_val.Equal(gf_val)
print("✅ 9.80665mps2 == 1gf (gravity)")

// Area units
area_sqm := 10000sqm
area_ha := 1ha  
check area_sqm.Equal(area_ha)
print("✅ 10000sqm == 1ha")

// Volume units
volume_cbm := 1cbm
volume_l := 1000L
check volume_cbm.Equal(volume_l)
print("✅ 1cbm == 1000L")

// Angle units (more precise)
angle_deg := 180deg
angle_rad := units.Rad.Multiply(3.141592653589793)
check angle_deg.Equal(angle_rad) 
print("✅ 180deg == πrad")

print("=== SOLUTION SUMMARY ===")
print("Your Unicode expressions → ASCII alternatives:")
print("  s² := s*s         → s_squared := s.Multiply(s.Value())")
print("  9.80665m/s²       → 9.80665mps2")
print("  180°              → 180deg") 
print("  10000m²           → 10000sqm")
print("  1m³               → 1cbm")
print("")
print("All compound unit expressions now work! 🎉")