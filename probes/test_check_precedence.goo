import "strings"
import "slices"

// Test check statements with 'not' and 'in' precedence
text := "hello world"
numbers := [1, 2, 3, 4, 5]

// These should all pass (no assertion failures)
check not "xyz" in text      // not (false) = true ✓
check not 7 in numbers       // not (false) = true ✓

printf("Check precedence tests passed!\n")