// Test various list syntax combinations

func main() {
	// Single element (should not break existing array type syntax)
	single := ['x']
	printf("Single: %v\n", single)
	
	// Empty list
	empty := []
	printf("Empty: %v\n", empty)
	
	// Mixed types with whitespace
	mixed := [1 "hello" 3.14]
	printf("Mixed: %v\n", mixed)
	
	// Nested lists with whitespace
	nested := [[1 2] [3 4]]
	printf("Nested: %v\n", nested)
	
	// Complex expressions
	exprs := [1+2 "a"+"b" len("hello")]
	printf("Expressions: %v\n", exprs)
}