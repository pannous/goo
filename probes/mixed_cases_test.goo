import strings
// Mixed variable/literal cases
text := "hello"
needle := "ell"

case1 := needle in "hello"      // variable in literal
case2 := "ell" in text          // literal in variable  
case3 := needle in text         // variable in variable

printf("needle in \"hello\": %t\n", case1)
printf("\"ell\" in text: %t\n", case2) 
printf("needle in text: %t\n", case3)

printf("ALL TESTS PASSED\n")
