import "strconv"

// Test x as string => x.String() method call conversion

// Define a custom type with String() method
type Person struct {
    name string
    age  int
}

func (p Person) String() string {
    return p.name + " (" + strconv.Itoa(p.age) + " years old)"
}

// Test the conversion
person := Person{name: "Alice", age: 30}
result := person as string

printf("Person as string: %s\n", result)
check result == "Alice (30 years old)"

// Test with pointer
personPtr := &person
result2 := personPtr as string
printf("Person pointer as string: %s\n", result2)