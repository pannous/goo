import "slices"

class User {
		Name string;
		Age int;
}
users := []User{{ Name: "Bob", Age: 17 }, { Name: "Charlie", Age: 22 }, { Name: "Alice", Age: 20 }, { Name: "Diana", Age: 15 }}
user := users.filter(u => u.Age > 18).first()

// Instead of:
var result string
if user and user.Name {
    result = user.Name
} else {
    result = "Anonymous"
}

// Clean:
result := user?.Name ?? "Anonymous"
result := user.?Name ?? "Anonymous"
put("First user over 18: ", result)