// Test for-in loop syntax
numbers := [1, 2, 3, 4, 5]

println("Testing for-in with slice:")
for num in numbers {
	printf("%d ", num)
}
printf("\n")

println("Testing for-in with string:")
for char in "hello" {
	printf("%c ", char)
}
printf("\n")

println("Testing for-in with map:")
myMap := map[string]int{
	"a": 1,
	"b": 2,
	"c": 3,
}

for key in myMap {
	printf("%s ", key)
}
printf("\n")

println("All for-in tests completed!")